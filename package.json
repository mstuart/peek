{
  "name": "peek-agent",
  "version": "0.1.0",
  "description": "DevTools for coding agents — historical context composition, compaction analysis, and cost attribution for Claude Code, Codex, and pi",
  "type": "module",
  "bin": {
    "peek": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Mark Stuart",
  "bugs": {
    "url": "https://github.com/mstuart/peek/issues"
  },
  "homepage": "https://github.com/mstuart/peek#readme",
  "keywords": [
    "cli",
    "devtools",
    "claude-code",
    "codex",
    "ai-agent",
    "llm",
    "context-window",
    "token-usage",
    "cost-tracking",
    "compaction",
    "session-diff",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstuart/peek.git"
  },
  "private": true,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
